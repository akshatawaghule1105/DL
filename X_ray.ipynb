
import tensorflow as tf
import matplotlib.pyplot as plt
from tensorflow import keras
from tensorflow.keras import layers
from zipfile import ZipFile

# Extract Dataset
with ZipFile(r"C:\Users\ADMIN\Downloads\Pneumonia X Ray-20221031T100017Z-001.zip") as z:
    z.extractall("chest_xray")

path = "chest_xray/chest_xray"

# Load Training Dataset
train = keras.utils.image_dataset_from_directory(
    path + "/train",
    image_size=(150, 150),
    batch_size=32,
    color_mode="grayscale"
)

# Load Validation Dataset
val = keras.utils.image_dataset_from_directory(
    path + "/val",
    image_size=(150, 150),
    batch_size=32,
    color_mode="grayscale"
)

# Load Testing Dataset
test = keras.utils.image_dataset_from_directory(
    path + "/test",
    image_size=(150, 150),
    batch_size=32,
    color_mode="grayscale",
    shuffle=False
)

# Display Classes
classes = train.class_names
print("Classes:", classes)

# Build CNN Model
model = keras.Sequential([
    keras.Input(shape=(150, 150, 1)),
    layers.Rescaling(1./255),

    layers.Conv2D(32, (3, 3), activation="relu"),
    layers.MaxPooling2D((2, 2)),

    layers.Conv2D(64, (3, 3), activation="relu"),
    layers.MaxPooling2D((2, 2)),

    layers.Flatten(),
    layers.Dense(64, activation="relu"),
    layers.Dropout(0.3),
    layers.Dense(1, activation="sigmoid")
])

# Display Model Summary
model.summary()

# Compile Model
model.compile(
    optimizer="adam",
    loss="binary_crossentropy",
    metrics=["accuracy"]
)

# Train Model
history = model.fit(
    train,
    validation_data=val,
    epochs=5
)

# Evaluate Model
loss, accuracy = model.evaluate(test)

print("Test Accuracy:", round(accuracy * 100, 2), "%")

# Make Prediction
images, labels = next(iter(test))

prediction = model.predict(images[:1], verbose=0)

predicted = int(prediction[0][0] >= 0.5)

print("Predicted:", classes[predicted])
print("Actual:", classes[int(labels[0])])

# Display X-Ray Image
plt.imshow(images[0].numpy().squeeze(), cmap="gray")
plt.title("Predicted: " + classes[predicted])
plt.axis("off")
plt.show()

# Plot Training and Validation Accuracy
plt.plot(history.history["accuracy"], label="Training")
plt.plot(history.history["val_accuracy"], label="Validation")

plt.xlabel("Epoch")
plt.ylabel("Accuracy")
plt.title("Pneumonia CNN Accuracy")
plt.legend()
plt.show()
